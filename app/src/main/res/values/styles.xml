<!-- res/values/styles.xml -->
<resources>

    <!-- ============================================================ -->
    <!-- ===== GLASSMORPHISM СТИЛИ ================================== -->
    <!-- ============================================================ -->

    <!-- Базовый стеклянный стиль кнопки -->
    <style name="Button.Glass" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Основная стеклянная кнопка (акцентная) -->
    <style name="Button.Glass.Primary" parent="Button.Glass">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_glass_button_primary</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Вторичная стеклянная кнопка (прозрачная) -->
    <style name="Button.Glass.Secondary" parent="Button.Glass">
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:background">@drawable/bg_glass_button_secondary</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>