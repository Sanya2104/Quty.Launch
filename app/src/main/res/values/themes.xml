<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовая тема для всех активностей -->
    <style name="Theme.QutyLaunch" parent="Theme.AppCompat.NoActionBar">
        <!-- Для Android 11+ обязательно прозрачные бары -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Для Android 13: обрабатываем вырез камеры -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- Важно! Запрещаем системе добавлять отступы -->
        <item name="android:fitsSystemWindows">false</item>

        <!-- Растягиваем окно под системные панели -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Тема для диалогов/попапов - наследуем основную тему -->
    <style name="Theme.AppCompat.Translucent" parent="Theme.QutyLaunch">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>