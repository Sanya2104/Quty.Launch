<!-- res/values/colors.xml -->
<resources>
    <!-- ============================================================ -->
    <!-- СУЩЕСТВУЮЩИЕ ЦВЕТА -->
    <!-- ============================================================ -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ============================================================ -->
    <!-- ЦВЕТА ИНТЕРФЕЙСА -->
    <!-- ============================================================ -->

    <!-- TabLayout (цвета для текста) -->
    <color name="tab_text_selected">@color/text_primary</color>
    <color name="tab_text_unselected">#8A8A8A</color>

    <!-- Logger backgrounds (остаются статическими для уровней логов) -->
    <color name="log_debug_bg">#1B5E20</color>
    <color name="log_info_bg">#0D47A1</color>
    <color name="log_warn_bg">#E65100</color>
    <color name="log_error_bg">#B71C1C</color>

    <!-- ============================================================ -->
    <!-- ОСНОВНЫЕ ЦВЕТА ТЕМЫ -->
    <!-- ============================================================ -->

    <!-- Фоны -->
    <color name="background_dark">#121212</color>
    <color name="background_card">#1E1E1E</color>
    <color name="background_item">#1A1A1A</color>
    <color name="background_input">#2A2A2A</color>
    <color name="background_warning">#332A2A</color>
    <color name="background_error">#332222</color>
    <color name="background_permission_item">#1E1E1E</color>

    <!-- Текст -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#CCCCCC</color>
    <color name="text_hint">#AAAAAA</color>
    <color name="text_muted">#888888</color>
    <color name="text_dim">#666666</color>
    <color name="text_error">#FF6B6B</color>

    <!-- Разделители и обводки -->
    <color name="divider">#333333</color>
    <color name="stroke">#444444</color>

    <!-- Цвета статусов -->
    <color name="status_granted">#4CAF50</color>
    <color name="status_denied">#FF6B6B</color>
    <color name="status_warning">#FF9800</color>

    <!-- Акценты (используются в коде для логов и источников) -->
    <color name="accent_green">#4CAF50</color>
    <color name="accent_blue">#2196F3</color>

    <!-- ============================================================ -->
    <!-- КНОПКИ (статичные, не зависящие от схемы) -->
    <!-- ============================================================ -->

    <color name="button_secondary">#4A4A4A</color>
    <color name="button_danger">#D32F2F</color>
    <color name="button_warning">#FF9800</color>
    <color name="button_clear_cache">#FF6F00</color>

    <!-- ============================================================ -->
    <!-- ЦВЕТОВЫЕ СХЕМЫ (Color Schemes) -->
    <!-- ============================================================ -->

    <!-- Red -->
    <color name="scheme_red_primary">#F44336</color>
    <color name="scheme_red_accent">#EF5350</color>

    <!-- Orange -->
    <color name="scheme_orange_primary">#FF9800</color>
    <color name="scheme_orange_accent">#FF5722</color>

    <!-- Lime (Лаймовый) -->
    <color name="scheme_lime_primary">#CDDC39</color>
    <color name="scheme_lime_accent">#D4E157</color>

    <!-- Green -->
    <color name="scheme_green_primary">#4CAF50</color>
    <color name="scheme_green_accent">#8BC34A</color>

    <!-- Teal (по умолчанию) -->
    <color name="scheme_teal_primary">#009688</color>
    <color name="scheme_teal_accent">#4CAF50</color>

    <!-- Cyan (Бирюзовый/Голубой) -->
    <color name="scheme_cyan_primary">#00BCD4</color>
    <color name="scheme_cyan_accent">#26C6DA</color>

    <!-- Blue -->
    <color name="scheme_blue_primary">#2196F3</color>
    <color name="scheme_blue_accent">#03A9F4</color>

    <!-- Purple -->
    <color name="scheme_purple_primary">#9C27B0</color>
    <color name="scheme_purple_accent">#E040FB</color>

    <!-- Pink -->
    <color name="scheme_pink_primary">#E91E63</color>
    <color name="scheme_pink_accent">#F06292</color>

</resources>