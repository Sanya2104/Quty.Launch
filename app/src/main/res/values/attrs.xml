<!-- res/values/attrs.xml -->
<resources>
    <!-- ============================================================ -->
    <!-- ===== КАСТОМНЫЕ АТРИБУТЫ ДЛЯ ЦВЕТОВОЙ СХЕМЫ И ТЕМЫ ========= -->
    <!-- ============================================================ -->

    <!-- Поверхности (фоны карточек, панелей) -->
    <attr name="colorSurface" format="color" />
    <attr name="colorOnSurface" format="color" />

    <!-- Кнопки -->
    <attr name="buttonPrimaryColor" format="color" />
    <attr name="buttonSecondaryColor" format="color" />
    <attr name="buttonDangerColor" format="color" />
    <attr name="buttonWarningColor" format="color" />
    <attr name="buttonClearCacheColor" format="color" />

    <!-- TabLayout -->
    <attr name="tabIndicatorColor" format="color" />
    <attr name="tabRippleColor" format="color" />

    <!-- Shell -->
    <attr name="shellActiveBackgroundColor" format="color" />

    <!-- Текст -->
    <attr name="textErrorColor" format="color" />
    <attr name="textPrimaryColor" format="color" />
    <attr name="textSecondaryColor" format="color" />
    <attr name="textHintColor" format="color" />
    <attr name="textMutedColor" format="color" />
    <attr name="textDimColor" format="color" />

    <!-- Цвета статусов (для кода) -->
    <attr name="statusWarningColor" format="color" />

    <!-- ============================================================ -->
    <!-- ===== НОВЫЕ АТРИБУТЫ ДЛЯ ФОНОВ ============================= -->
    <!-- ============================================================ -->

    <!-- Фоны (для переключения Dark/Light) -->
    <attr name="backgroundWarning" format="color" />
    <attr name="backgroundError" format="color" />
    <attr name="backgroundInput" format="color" />
    <attr name="backgroundPermissionItem" format="color" />

    <!-- Разделители -->
    <attr name="dividerColor" format="color" />
    <attr name="strokeColor" format="color" />

    <!-- ============================================================ -->
    <!-- ===== НОВЫЕ АТРИБУТЫ ДЛЯ ИКОНОК ============================ -->
    <!-- ============================================================ -->

    <!-- Цвет для иконок (меняется в зависимости от темы) -->
    <attr name="iconTintColor" format="color" />

    <!-- Цвет для иконок в активном состоянии -->
    <attr name="iconTintActiveColor" format="color" />

    <!-- Цвет для иконок в неактивном состоянии -->
    <attr name="iconTintInactiveColor" format="color" />

</resources>