<!-- res/values-night/colors.xml -->
<resources>
    <!-- ============================================================ -->
    <!-- ТЁМНАЯ ТЕМА (DARK THEME)                                     -->
    <!-- Переопределяем цвета для ночного режима                      -->
    <!-- ============================================================ -->

