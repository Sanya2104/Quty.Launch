    <!-- ===== ТЕМЫ С РАЗНЫМИ ЦВЕТОВЫМИ СХЕМАМИ (LIGHT) ============= -->
    <!-- ============================================================ -->

    <!-- Все 9 тем копируются из values/themes.xml -->
    <!-- Они уже используют атрибуты, поэтому просто переопределяем базовую тему -->

