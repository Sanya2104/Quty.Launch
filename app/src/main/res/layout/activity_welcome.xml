<!-- res/layout/activity_welcome.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_horizontal"
        android:gravity="center_horizontal">

        <!-- ===== ИКОНКА ===== -->
        <ImageView
            android:layout_width="@dimen/icon_xlarge"
            android:layout_height="@dimen/icon_xlarge"
            android:layout_marginTop="@dimen/spacing_xxxl"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <!-- ===== ЗАГОЛОВОК ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            style="@style/Text.Title.Large"
            android:text="@string/welcome_title"
            android:gravity="center" />

        <!-- ===== ПОДЗАГОЛОВОК ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            style="@style/Text.Body.Secondary"
            android:text="@string/welcome_subtitle"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/spacing_xxs" />

        <!-- ===== ПРОГРЕСС-БАР ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/progress_bar_height"
                android:layout_weight="1"
                android:progress="0"
                android:max="100"
                android:progressTint="?attr/buttonPrimaryColor"
                android:background="@color/background_input" />

            <TextView
                android:id="@+id/progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                style="@style/Text.Body"
                android:text="@string/_0"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- ===== СПИСОК РАЗРЕШЕНИЙ ===== -->
        <LinearLayout
            android:id="@+id/permissions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:orientation="vertical" />

        <!-- ===== КНОПКА ===== -->
        <Button
            android:id="@+id/btn_grant"
            style="@style/Button.Primary"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/welcome_button_grant"
            android:enabled="false"
            android:alpha="0.5" />

        <!-- ===== ОШИБКА ===== -->
        <LinearLayout
            android:id="@+id/error_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:orientation="vertical"
            android:background="@color/background_error"
            android:padding="@dimen/spacing_l"
            android:visibility="gone"
            app:cornerRadius="@dimen/radius_medium">

            <TextView
                android:id="@+id/error_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Text.Title.Small"
                android:text="@string/welcome_permission_denied_title"
                android:textColor="?attr/textErrorColor"
                android:gravity="center" />

            <TextView
                android:id="@+id/error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                style="@style/Text.Body.Secondary"
                android:text="@string/welcome_permission_denied_message"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/spacing_xxs" />

            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_retry"
                    style="@style/Button.Danger"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/height_button"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:text="@string/welcome_button_retry"
                    app:cornerRadius="@dimen/radius_circle" />

                <Button
                    android:id="@+id/btn_settings"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/height_button"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:text="@string/welcome_button_settings"
                    app:cornerRadius="@dimen/radius_circle" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== ВЕРСИЯ ===== -->
        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            style="@style/Text.XSmall"
            android:text="@string/version_format"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>