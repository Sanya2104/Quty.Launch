<!-- res/layout/fragment_settings_about.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:padding="@dimen/screen_padding_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Заглушка -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            style="@style/Text.Title.Medium"
            android:text="О системе"
            android:gravity="center"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            style="@style/Text.Body.Secondary"
            android:text="Здесь будет:\n• Иконка приложения\n• Версия и код версии\n• Канал сборки\n• Модель устройства\n• Версия Android\n• SDK уровень\n• Информация об оболочке"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/spacing_s"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</ScrollView>