<!-- res/layout/dialog_restart.xml -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Стеклянная карточка (без CardView) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/spacing_xl"
        android:background="@drawable/bg_glass_dialog"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Иконка -->
        <ImageView
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:layout_gravity="center"
            android:src="@drawable/ic_restart"
            android:background="@drawable/bg_glass_icon"
            android:padding="@dimen/spacing_m"
            android:contentDescription="@string/empty" />

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/dialog_apply_parameters_title"
            android:textSize="@dimen/text_xl"
            android:textColor="?attr/textPrimaryColor"
            android:gravity="center"
            android:textStyle="bold" />

        <!-- Сообщение -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/spacing_xxs"
            android:text="@string/dialog_apply_parameters_message"
            android:textColor="?attr/textSecondaryColor"
            android:textSize="@dimen/text_m"
            android:breakStrategy="simple" />

        <!-- Кнопки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_later"
                style="@style/Button.Glass.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_weight="1"
                android:text="@string/dialog_later" />

            <Button
                android:id="@+id/btn_restart"
                style="@style/Button.Glass.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_weight="1"
                android:text="@string/dialog_restart" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>