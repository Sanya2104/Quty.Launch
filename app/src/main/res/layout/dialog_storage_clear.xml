<!-- res/layout/dialog_storage_clear.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/spacing_l"
    android:paddingEnd="@dimen/spacing_l"
    android:paddingTop="@dimen/spacing_xl"
    android:paddingBottom="@dimen/spacing_xl">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/radius_large"
        app:cardElevation="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="600dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l">

                <!-- ============================================================ -->
                <!-- ===== ЗАГОЛОВОК ============================================ -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_m">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Title.Medium"
                        android:text="@string/storage_clear_title" />

                    <ImageButton
                        android:id="@+id/storage_clear_close_button"
                        android:layout_width="@dimen/icon_large"
                        android:layout_height="@dimen/icon_large"
                        android:src="@drawable/ic_close"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close"
                        android:padding="@dimen/spacing_s" />

                </LinearLayout>

                <!-- ============================================================ -->
                <!-- ===== КОНТЕЙНЕР ДЛЯ ЧЕКБОКСОВ ============================== -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:id="@+id/storage_clear_checkboxes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- ============================================================ -->
                <!-- ===== РАЗДЕЛИТЕЛЬ ========================================== -->
                <!-- ============================================================ -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:layout_marginBottom="@dimen/spacing_m"
                    android:background="?attr/dividerColor" />

                <!-- ============================================================ -->
                <!-- ===== КНОПКИ =============================================== -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <Button
                        android:id="@+id/storage_clear_cancel_button"
                        style="@style/Button.Glass.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_button"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="@string/cancel" />

                    <Button
                        android:id="@+id/storage_clear_confirm_button"
                        style="@style/Button.Glass.Primary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/height_button"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:minWidth="0dp"
                        android:text="@string/storage_clear_button" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

</FrameLayout>