<!-- res/layout/fragment_store_placeholder.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:paddingTop="@dimen/fragment_top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_xl">

        <ImageView
            android:layout_width="@dimen/icon_xxlarge"
            android:layout_height="@dimen/icon_xxlarge"
            android:src="@drawable/ic_store"
            android:contentDescription="@string/empty"
            app:tint="?attr/textDimColor"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/placeholder_title"
            style="@style/Text.Title.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            tools:text="@string/store_menu_shells" />

        <TextView
            android:id="@+id/placeholder_message"
            style="@style/Text.Body.Dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            tools:text="@string/store_placeholder_shells" />

    </LinearLayout>

</FrameLayout>