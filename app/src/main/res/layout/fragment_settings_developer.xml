<!-- res/layout/fragment_settings_developer.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 1. ОТЛАДКА WEBVIEW ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingTop="8dp"
            android:text="@string/dev_section_webview"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_card"
            android:orientation="vertical"
            android:padding="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/dev_webview_debug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:padding="8dp"
                android:text="@string/dev_webview_debug"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/dev_clear_cache"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/button_secondary"
                android:text="@string/dev_webview_clear_cache"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- ===== 2. ИНФОРМАЦИЯ ОБ ОБОЛОЧКЕ ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingTop="24dp"
            android:text="@string/dev_section_shell"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_card"
            android:orientation="vertical"
            android:padding="8dp">

            <Button
                android:id="@+id/dev_shell_manifest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/button_secondary"
                android:text="@string/dev_shell_manifest"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/dev_shell_reload"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/accent_orange"
                android:text="@string/dev_shell_reload"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- ===== 3. СИСТЕМНАЯ ИНФОРМАЦИЯ ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingTop="24dp"
            android:text="@string/dev_section_system"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_card"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_device_model"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dev_device_model_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unknown"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_android_version"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dev_android_version_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unknown"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_sdk_level"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dev_sdk_level_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unknown"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_app_version"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dev_app_version_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unknown"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_app_code"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dev_app_code_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unknown"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_app_channel"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dev_app_channel_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unknown"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== 4. УПРАВЛЕНИЕ ДАННЫМИ ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingTop="24dp"
            android:text="@string/dev_section_data"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_card"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Размер кэша -->
            <LinearLayout
                android:id="@+id/dev_cache_size_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_cache_size"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dev_cache_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dev_cache_size_value"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textAlignment="viewEnd" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <!-- Размер оболочек -->
            <LinearLayout
                android:id="@+id/dev_shells_size_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_shells_size"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dev_shells_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dev_shells_size_value"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textAlignment="viewEnd" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <!-- Размер логов -->
            <LinearLayout
                android:id="@+id/dev_logs_size_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_logs_size"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dev_logs_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dev_logs_size_value"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textAlignment="viewEnd" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <!-- Очистить кэш приложений -->
            <Button
                android:id="@+id/dev_clear_apps_cache"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/button_clear_cache"
                android:text="@string/dev_clear_apps_cache"
                android:textColor="@color/text_primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp" />

            <!-- Очистить данные -->
            <Button
                android:id="@+id/dev_clear_data"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/button_danger"
                android:text="@string/dev_clear_data"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- ===== 5. УПРАВЛЕНИЕ ЛОГАМИ ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingTop="24dp"
            android:text="@string/dev_section_logs"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_card"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Сохранять логи в файл -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/dev_logs_persist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:padding="8dp"
                android:text="@string/dev_logs_persist"
                android:textColor="@color/text_primary"
                android:checked="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Максимум файлов -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:padding="0dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_logs_max_files"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/dev_logs_max_files"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="100dp"
                    android:background="@drawable/spinner_bg"
                    android:popupBackground="@color/background_card"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Максимум на файл -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:padding="0dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dev_logs_max_size"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/dev_logs_max_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="100dp"
                    android:background="@drawable/spinner_bg"
                    android:popupBackground="@color/background_card"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Кнопка "Показать логи" -->
            <Button
                android:id="@+id/dev_logs_show"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/button_secondary"
                android:text="@string/dev_logs_show"
                android:textColor="@color/text_primary" />

            <!-- Кнопка "Очистить логи" -->
            <Button
                android:id="@+id/dev_logs_clear"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/button_danger"
                android:text="@string/dev_logs_clear"
                android:textColor="@color/text_primary" />

            <!-- Кнопка "Сбросить настройки" -->
            <Button
                android:id="@+id/dev_logs_reset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:backgroundTint="@color/accent_orange"
                android:text="@string/dev_logs_reset"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- ===== 6. ИНСТРУМЕНТЫ ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingTop="24dp"
            android:text="@string/dev_section_tools"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_card"
            android:orientation="vertical"
            android:padding="8dp">

            <Button
                android:id="@+id/dev_restart_app"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/button_restart"
                android:text="@string/dev_restart_app"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- Отступ снизу -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>

</ScrollView>