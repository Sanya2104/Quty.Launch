<!-- res/layout/item_log.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_s"
    android:background="?attr/colorSurface"
    android:layout_marginBottom="@dimen/spacing_xxs">

    <!-- ===== ВЕРХНЯЯ СТРОКА ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Уровень -->
        <TextView
            android:id="@+id/tv_log_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_s"
            android:paddingTop="@dimen/spacing_xxs"
            android:paddingBottom="@dimen/spacing_xxs"
            style="@style/Text.XSmall"
            android:textStyle="bold"
            android:textColor="?attr/textPrimaryColor"
            android:background="@drawable/bg_log_level_debug"
            android:layout_marginEnd="@dimen/spacing_s" />

        <!-- Время -->
        <TextView
            android:id="@+id/tv_log_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.XSmall"
            android:textColor="?attr/textDimColor"
            android:layout_marginEnd="@dimen/spacing_s" />

        <!-- Тег -->
        <TextView
            android:id="@+id/tv_log_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Text.Small"
            android:textStyle="bold"
            android:textColor="?attr/textHintColor"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Источник -->
        <TextView
            android:id="@+id/tv_log_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.XSmall"
            android:textColor="?attr/textDimColor"
            android:layout_marginStart="@dimen/spacing_s" />

    </LinearLayout>

    <!-- ===== СООБЩЕНИЕ ===== -->
    <TextView
        android:id="@+id/tv_log_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxs"
        style="@style/Text.Body"
        android:textColor="?attr/textPrimaryColor"
        android:maxLines="5"
        android:ellipsize="end" />

</LinearLayout>