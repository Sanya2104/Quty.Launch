<!-- res/layout/activity_logger.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- ===== ВЕРХНЯЯ ПАНЕЛЬ ===== -->
    <LinearLayout
        style="@style/Toolbar">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Text.Title.Medium"
            android:text="@string/logger_title" />

        <ImageButton
            android:id="@+id/btn_pause"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:src="@drawable/ic_pause"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logger_pause"
            android:padding="@dimen/spacing_m" />

        <ImageButton
            android:id="@+id/btn_copy"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:src="@drawable/ic_copy"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logger_copy"
            android:padding="@dimen/spacing_m" />

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:src="@drawable/ic_share"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logger_share"
            android:padding="@dimen/spacing_m" />

        <ImageButton
            android:id="@+id/btn_save"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:src="@drawable/ic_save"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logger_save"
            android:padding="@dimen/spacing_m" />

        <ImageButton
            android:id="@+id/btn_clear"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:src="@drawable/ic_clear"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logger_clear"
            android:padding="@dimen/spacing_m" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/logger_close"
            android:padding="@dimen/spacing_m" />

    </LinearLayout>

    <!-- ===== ПАНЕЛЬ УВЕДОМЛЕНИЯ О ПАУЗЕ ===== -->
    <LinearLayout
        android:id="@+id/pause_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="@dimen/spacing_s"
        android:background="@color/background_warning"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.Body"
            android:text="@string/logger_paused"
            android:textColor="@color/status_warning" />

    </LinearLayout>

    <!-- ===== СПИСОК ЛОГОВ ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_logs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/spacing_s"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- ===== НИЖНЯЯ ПАНЕЛЬ ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Toolbar"
        android:paddingStart="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_l">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Text.Small"
            android:text="@string/logger_status" />

        <Spinner
            android:id="@+id/spinner_level"
            style="@style/Spinner" />

        <Spinner
            android:id="@+id/spinner_source"
            style="@style/Spinner"
            android:layout_marginStart="@dimen/spacing_s" />

    </LinearLayout>

</LinearLayout>