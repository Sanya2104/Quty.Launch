<!-- res/layout/fragment_store_shell_detail.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="@dimen/screen_padding_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/fragment_top"
        android:orientation="vertical">

        <!-- Превью -->
        <ImageView
            android:id="@+id/shell_preview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/shell_preview_height"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_image"
            android:layout_marginBottom="@dimen/spacing_l"
            android:contentDescription="@string/settings_personalization_shell_preview_description" />

        <!-- Название -->
        <TextView
            android:id="@+id/shell_name"
            style="@style/Text.Title.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/textPrimaryColor"
            tools:text="QutyAuto" />

        <!-- Автор -->
        <TextView
            android:id="@+id/shell_author"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:textColor="?attr/textDimColor"
            tools:text="QutyTeam" />

        <!-- Блок информации (как в диалоге оболочки) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/spacing_xs">

            <!-- Версия -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_version"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_version" />

                <TextView
                    android:id="@+id/shell_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="0.0.1" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor" />

            <!-- Тип -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_type"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_type" />

                <TextView
                    android:id="@+id/shell_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="Встроенная" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor" />

            <!-- Мин. версия -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_min_version"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_min_version" />

                <TextView
                    android:id="@+id/shell_min_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="0.0.0" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor" />

            <!-- Ориентация -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_orientation"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_orientation" />

                <TextView
                    android:id="@+id/shell_orientation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="Авто" />

            </LinearLayout>

            <!-- Репозиторий -->
            <LinearLayout
                android:id="@+id/shell_repo_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/spacing_l"
                    android:layout_marginEnd="@dimen/spacing_l"
                    android:background="?attr/dividerColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_l"
                    android:paddingEnd="@dimen/spacing_l"
                    android:paddingTop="@dimen/spacing_s"
                    android:paddingBottom="@dimen/spacing_s"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_repo"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_repo" />

                    <Button
                        android:id="@+id/shell_repo_button"
                        style="@style/Button.Glass.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="@dimen/spacing_m"
                        android:paddingEnd="@dimen/spacing_m"
                        android:paddingTop="@dimen/spacing_s"
                        android:paddingBottom="@dimen/spacing_s"
                        android:text="@string/settings_personalization_shell_info_repo_open" />

                </LinearLayout>

            </LinearLayout>

            <!-- Telegram -->
            <LinearLayout
                android:id="@+id/shell_telegram_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/spacing_l"
                    android:layout_marginEnd="@dimen/spacing_l"
                    android:background="?attr/dividerColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_l"
                    android:paddingEnd="@dimen/spacing_l"
                    android:paddingTop="@dimen/spacing_s"
                    android:paddingBottom="@dimen/spacing_s"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_telegram"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_telegram" />

                    <Button
                        android:id="@+id/shell_telegram_button"
                        style="@style/Button.Glass.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="@dimen/spacing_m"
                        android:paddingEnd="@dimen/spacing_m"
                        android:paddingTop="@dimen/spacing_s"
                        android:paddingBottom="@dimen/spacing_s"
                        android:text="@string/settings_personalization_shell_info_telegram_open" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Кнопка действия -->
        <Button
            android:id="@+id/btn_install"
            style="@style/Button.Glass.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_large"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_xxl"
            android:text="@string/store_install" />

    </LinearLayout>

</ScrollView>