<!-- res/layout/fragment_store_library.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:paddingTop="@dimen/fragment_top">

    <!-- Список оболочек -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_library"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_s"
        android:paddingEnd="@dimen/spacing_s"
        android:paddingTop="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_m"
        android:scrollbars="vertical"
        android:visibility="gone" />

    <!-- Пустое состояние -->
    <LinearLayout
        android:id="@+id/library_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="@dimen/icon_xxlarge"
            android:layout_height="@dimen/icon_xxlarge"
            android:src="@drawable/ic_folder"
            app:tint="?attr/textDimColor"
            tools:ignore="ContentDescription" />

        <TextView
            style="@style/Text.Body.Dim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/store_empty_library" />
    </LinearLayout>

</FrameLayout>