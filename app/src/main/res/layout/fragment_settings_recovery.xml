<!-- res/layout/fragment_settings_recovery.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/fragment_top"
        android:orientation="vertical">

        <!-- ============================================================ -->
        <!-- ===== СЕКЦИЯ 1: ВОССТАНОВЛЕНИЕ НАСТРОЕК ==================== -->
        <!-- ============================================================ -->

        <TextView
            style="@style/Text.Title.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:text="@string/settings_recovery_section_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/spacing_xs">

            <!-- Сделать backup настроек -->
            <LinearLayout
                android:id="@+id/recovery_backup_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_item_rounded"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_recovery_backup"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/recovery_backup_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Small"
                        android:text="@string/recovery_backup_desc" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_arrow_forward"
                    android:contentDescription="@string/empty" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor" />

            <!-- Восстановить настройки -->
            <LinearLayout
                android:id="@+id/recovery_restore_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_item_rounded"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_recovery_restore"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/recovery_restore_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Small"
                        android:text="@string/recovery_restore_desc" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_arrow_forward"
                    android:contentDescription="@string/empty" />

            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ===== СЕКЦИЯ 2: ПОЛНЫЙ СБРОС НАСТРОЕК ====================== -->
        <!-- ============================================================ -->

        <TextView
            style="@style/Text.Title.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/recovery_reset_section_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/spacing_xs">

            <!-- Полный сброс настроек -->
            <LinearLayout
                android:id="@+id/recovery_full_reset_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_item_rounded"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_recovery"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/recovery_reset_title"
                        android:textColor="?attr/textErrorColor" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Small"
                        android:text="@string/recovery_reset_desc" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_arrow_forward"
                    android:contentDescription="@string/empty" />

            </LinearLayout>

        </LinearLayout>

        <!-- Отступ снизу -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxl" />

    </LinearLayout>

</ScrollView>