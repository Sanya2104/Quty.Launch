<!-- res/layout/item_logger_file.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_s"
    android:layout_marginEnd="@dimen/spacing_s"
    android:layout_marginBottom="@dimen/spacing_s"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_rounded_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/spacing_l"
    android:paddingEnd="@dimen/spacing_s"
    android:paddingTop="@dimen/spacing_l"
    android:paddingBottom="@dimen/spacing_l"
    tools:ignore="UseCompoundDrawables">

    <ImageView
        android:layout_width="@dimen/icon_small"
        android:layout_height="@dimen/icon_small"
        android:layout_marginEnd="@dimen/spacing_m"
        android:src="@drawable/ic_folder"
        android:contentDescription="@string/empty" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/logger_file_name"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/textPrimaryColor"
            android:maxLines="1"
            android:ellipsize="middle"
            tools:text="log_2026-10-11_14-30-00.log" />

        <TextView
            android:id="@+id/logger_file_meta"
            style="@style/Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/textDimColor"
            tools:text="14:30 · 12.34 KB" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/logger_file_menu"
        android:layout_width="@dimen/icon_large"
        android:layout_height="@dimen/icon_large"
        android:layout_marginStart="@dimen/spacing_s"
        android:src="@drawable/ic_menu_dots"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/shell_menu_description"
        android:padding="@dimen/spacing_m"
        tools:ignore="ContentDescription" />

</LinearLayout>