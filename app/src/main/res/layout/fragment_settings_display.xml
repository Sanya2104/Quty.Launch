<!-- res/layout/fragment_settings_display.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ориентация экрана -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_orientation_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="16dp"
            android:paddingTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp">

            <!-- Подсказка о блокировке ориентации темой (по умолчанию скрыта) -->
            <TextView
                android:id="@+id/orientation_lock_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orientation_lock_hint_default"
                android:textColor="#FF9800"
                android:textSize="14sp"
                android:padding="8dp"
                android:background="#332A2A"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/orientation_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/orientation_sensor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/orientation_auto"
                    android:textColor="#FFFFFF"
                    tools:ignore="VisualLintButtonSize" />

                <RadioButton
                    android:id="@+id/orientation_portrait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/orientation_portrait"
                    android:textColor="#FFFFFF"
                    tools:ignore="VisualLintButtonSize" />

                <RadioButton
                    android:id="@+id/orientation_landscape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/orientation_landscape"
                    android:textColor="#FFFFFF"
                    tools:ignore="VisualLintButtonSize" />

            </RadioGroup>
        </LinearLayout>

        <!-- Дополнительные настройки -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_additional_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="16dp"
            android:paddingTop="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp">

            <!-- Строгий режим - доступен только при включенном полноэкранном -->
            <CheckBox
                android:id="@+id/fullscreen_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:enabled="true"
                android:minHeight="48dp"
                android:text="@string/additional_fullscreen"
                android:textColor="#FFFFFF"
                tools:ignore="VisualLintButtonSize" />

            <CheckBox
                android:id="@+id/strict_mode_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.5"
                android:checked="false"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="@string/additional_strict_mode"
                android:textColor="#FFFFFF"
                tools:ignore="VisualLintButtonSize" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>