<!-- res/layout/fragment_settings_display.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:padding="@dimen/screen_padding_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== ОРИЕНТАЦИЯ ===== -->
        <TextView
            style="@style/Text.Title.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_s"
            android:text="@string/settings_orientation_title" />

        <LinearLayout
            style="@style/Card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- Подсказка о блокировке -->
            <TextView
                android:id="@+id/orientation_lock_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_s"
                android:background="@color/background_warning"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_m"
                style="@style/Text.Body"
                android:text="@string/orientation_lock_hint_default"
                android:textColor="@color/status_warning" />

            <RadioGroup
                android:id="@+id/orientation_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/orientation_sensor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="@dimen/height_button"
                    style="@style/Text.Body"
                    android:text="@string/orientation_auto"
                    tools:ignore="VisualLintButtonSize" />

                <RadioButton
                    android:id="@+id/orientation_portrait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/height_button"
                    style="@style/Text.Body"
                    android:text="@string/orientation_portrait"
                    tools:ignore="VisualLintButtonSize" />

                <RadioButton
                    android:id="@+id/orientation_landscape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/height_button"
                    style="@style/Text.Body"
                    android:text="@string/orientation_landscape"
                    tools:ignore="VisualLintButtonSize" />

            </RadioGroup>
        </LinearLayout>

        <!-- ===== ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ===== -->
        <TextView
            style="@style/Text.Title.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/settings_additional_title" />

        <LinearLayout
            style="@style/Card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <CheckBox
                android:id="@+id/fullscreen_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:enabled="true"
                android:minHeight="@dimen/height_button"
                style="@style/Text.Body"
                android:text="@string/additional_fullscreen"
                tools:ignore="VisualLintButtonSize" />

            <CheckBox
                android:id="@+id/strict_mode_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:alpha="0.5"
                android:checked="false"
                android:enabled="false"
                android:minHeight="@dimen/height_button"
                style="@style/Text.Body"
                android:text="@string/additional_strict_mode"
                tools:ignore="VisualLintButtonSize" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>