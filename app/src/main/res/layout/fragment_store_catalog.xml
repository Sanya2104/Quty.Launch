<!-- res/layout/fragment_store_catalog.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:paddingTop="@dimen/fragment_top"
    android:orientation="vertical">

    <!-- ============================================================ -->
    <!-- ===== ЧИПЫ-ФИЛЬТРЫ ========================================= -->
    <!-- ============================================================ -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_xs"
        android:scrollbars="none"
        tools:ignore="SpeakableTextPresentCheck">

        <LinearLayout
            android:id="@+id/store_filters_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_l"
            android:paddingEnd="@dimen/spacing_l" />

    </HorizontalScrollView>

    <!-- ============================================================ -->
    <!-- ===== СПИСОК / СОСТОЯНИЯ =================================== -->
    <!-- ============================================================ -->

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Список -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_items"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/spacing_s"
                android:paddingEnd="@dimen/spacing_s"
                android:paddingTop="@dimen/spacing_s"
                android:paddingBottom="@dimen/spacing_m"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <!-- Состояние загрузки -->
            <LinearLayout
                android:id="@+id/loading_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="@dimen/icon_large"
                    android:layout_height="@dimen/icon_large"
                    android:indeterminate="true" />

                <TextView
                    style="@style/Text.Body.Dim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:text="@string/store_loading" />

            </LinearLayout>

            <!-- Состояние ошибки -->
            <LinearLayout
                android:id="@+id/error_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_xxlarge"
                    android:layout_height="@dimen/icon_xxlarge"
                    android:src="@drawable/ic_update_error"
                    app:tint="?attr/textErrorColor"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/error_message"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:gravity="center"
                    tools:text="@string/store_load_error" />

                <Button
                    android:id="@+id/btn_retry"
                    style="@style/Button.Glass.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/height_button"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="@string/welcome_button_retry" />

            </LinearLayout>

            <!-- Пустое состояние -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_xl"
                android:visibility="gone"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_xxlarge"
                    android:layout_height="@dimen/icon_xxlarge"
                    android:src="@drawable/ic_store"
                    app:tint="?attr/textDimColor"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/empty_message"
                    style="@style/Text.Body.Dim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:gravity="center"
                    tools:text="@string/store_empty_all" />

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>