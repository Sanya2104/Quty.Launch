<!-- res/layout/activity_parameters.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- ===== ШАПКА ===== -->
    <LinearLayout
        style="@style/Toolbar"
        android:padding="@dimen/spacing_s">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Text.Title.Large"
            android:text="@string/parameters_title" />

        <Button
            android:id="@+id/close_button"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="✕"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_xxl"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- ===== TABLAYOUT ===== -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:tabIndicatorColor="?attr/tabIndicatorColor"
        app:tabIndicatorHeight="@dimen/spacing_xxs"
        app:tabSelectedTextColor="?attr/textPrimaryColor"
        app:tabTextColor="@color/tab_text_unselected"
        app:tabRippleColor="?attr/tabRippleColor"
        app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
        app:tabPadding="@dimen/spacing_m"
        app:tabMode="fixed"
        app:tabGravity="fill"/>

    <!-- ===== VIEWPAGER ===== -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>