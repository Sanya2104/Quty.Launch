<!-- res/layout/item_welcome_permission.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_item_rounded"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="@dimen/spacing_l"
    android:paddingEnd="@dimen/spacing_l"
    android:paddingTop="@dimen/spacing_l"
    android:paddingBottom="@dimen/spacing_l"
    tools:ignore="UseCompoundDrawables">

    <!-- Иконка разрешения -->
    <ImageView
        android:id="@+id/permission_icon"
        android:layout_width="@dimen/icon_small"
        android:layout_height="@dimen/icon_small"
        android:layout_marginEnd="@dimen/spacing_m"
        android:src="@drawable/ic_phone"
        android:contentDescription="@string/empty" />

    <!-- Блок: название + описание -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/permission_title"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/textPrimaryColor"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="@string/welcome_permission_phone" />

        <TextView
            android:id="@+id/permission_description"
            style="@style/Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="@string/welcome_permission_phone_desc" />

    </LinearLayout>

    <!-- Статус + стрелка -->
    <TextView
        android:id="@+id/permission_status"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_s"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewEnd"
        tools:text="@string/permission_denied" />

    <ImageView
        android:layout_width="@dimen/icon_small"
        android:layout_height="@dimen/icon_small"
        android:layout_marginStart="@dimen/spacing_s"
        android:src="@drawable/ic_arrow_forward"
        android:contentDescription="@string/empty" />

</LinearLayout>