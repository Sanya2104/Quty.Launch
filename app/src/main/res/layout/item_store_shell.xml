<!-- res/layout/item_store_shell.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_m"
    android:background="?attr/colorSurface"
    android:layout_marginBottom="@dimen/spacing_s"
    android:gravity="center_vertical">

    <!-- ===== ПРЕВЬЮ ===== -->
    <FrameLayout
        android:layout_width="@dimen/icon_xlarge"
        android:layout_height="@dimen/icon_xlarge"
        android:layout_marginEnd="@dimen/spacing_m">

        <ImageView
            android:id="@+id/shell_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="?android:attr/colorBackground"
            android:contentDescription="@string/store_preview_description"
            tools:src="@drawable/ic_parameters" />

        <!-- ===== БЭЙДЖ "УСТАНОВЛЕНО" ===== -->
        <View
            android:id="@+id/installed_badge"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxs"
            android:layout_gravity="bottom"
            android:background="@color/status_granted"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ===== ИНФОРМАЦИЯ ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Название -->
        <TextView
            android:id="@+id/shell_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.Title.XSmall"
            android:textColor="?attr/textPrimaryColor"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="@string/unknown" />

        <!-- Автор -->
        <TextView
            android:id="@+id/shell_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.Small"
            android:textColor="?attr/textDimColor"
            tools:text="@string/unknown" />

        <!-- Описание -->
        <TextView
            android:id="@+id/shell_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            style="@style/Text.Small"
            android:textColor="?attr/textHintColor"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="@string/unknown" />

        <!-- Размер -->
        <TextView
            android:id="@+id/shell_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            style="@style/Text.XSmall"
            android:textColor="?attr/textDimColor"
            tools:text="@string/unknown" />

    </LinearLayout>

    <!-- ===== КНОПКА ===== -->
    <Button
        android:id="@+id/btn_install"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_button"
        android:minWidth="@dimen/spacing_xxl"
        android:paddingStart="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_l"
        android:text="@string/store_install"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_s"
        android:fontFamily="sans-serif-medium"
        android:backgroundTint="?attr/buttonPrimaryColor"
        tools:text="@string/store_install" />

</LinearLayout>