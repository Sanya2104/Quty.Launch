<!-- res/layout/fragment_settings_system.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:padding="@dimen/screen_padding_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== ИНФОРМАЦИЯ О СИСТЕМЕ ===== -->
        <TextView
            style="@style/Text.Title.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_s"
            android:text="@string/system_info_title" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/version_label" />

                <TextView
                    android:id="@+id/version_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/version_unknown"
                    android:textAlignment="viewEnd" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="@color/divider"
                android:layout_marginVertical="@dimen/spacing_xxs" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/version_code_label" />

                <TextView
                    android:id="@+id/version_code_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/unknown_code"
                    android:textAlignment="viewEnd" />

            </LinearLayout>

            <View
                android:id="@+id/channel_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="@color/divider"
                android:layout_marginVertical="@dimen/spacing_xxs"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/channel_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/channel_label" />

                <TextView
                    android:id="@+id/channel_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/empty"
                    android:textAlignment="viewEnd" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== ИНФОРМАЦИЯ О ПРИЛОЖЕНИИ ===== -->
        <TextView
            style="@style/Text.Title.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_s"
            android:text="@string/update_info_title" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <LinearLayout
                android:id="@+id/install_from_file_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body"
                    android:text="@string/install_from_file" />

                <TextView
                    android:id="@+id/install_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Small"
                    android:text="@string/empty"
                    android:textColor="@color/status_granted"
                    android:visibility="gone" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="@color/divider"
                android:layout_marginVertical="@dimen/spacing_s" />

            <LinearLayout
                android:id="@+id/check_update_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body"
                    android:text="@string/check_updates_online_button" />

                <TextView
                    android:id="@+id/update_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Small"
                    android:text="@string/empty"
                    android:textColor="@color/status_granted"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>