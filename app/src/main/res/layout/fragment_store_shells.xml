<!-- res/layout/fragment_store_shells.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:paddingTop="@dimen/fragment_top">

    <!-- Состояние загрузки -->
    <LinearLayout
        android:id="@+id/loading_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:indeterminate="true" />

        <TextView
            style="@style/Text.Body.Dim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/store_loading" />
    </LinearLayout>

    <!-- Состояние ошибки -->
    <LinearLayout
        android:id="@+id/error_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/icon_xxlarge"
            android:layout_height="@dimen/icon_xxlarge"
            android:src="@drawable/ic_update_error"
            app:tint="?attr/textErrorColor"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/error_message"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:gravity="center"
            tools:text="@string/store_load_error" />

        <Button
            android:id="@+id/btn_retry"
            style="@style/Button.Glass.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/height_button"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/welcome_button_retry" />
    </LinearLayout>

    <!-- Пустое состояние -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="@dimen/icon_xxlarge"
            android:layout_height="@dimen/icon_xxlarge"
            android:src="@drawable/ic_store"
            app:tint="?attr/textDimColor"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            tools:ignore="ContentDescription" />

        <TextView
            style="@style/Text.Body.Dim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/store_empty_shells" />
    </LinearLayout>

    <!-- Список оболочек -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_shells"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_s"
        android:paddingEnd="@dimen/spacing_s"
        android:paddingTop="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_m"
        android:scrollbars="vertical"
        android:visibility="gone" />

</FrameLayout>