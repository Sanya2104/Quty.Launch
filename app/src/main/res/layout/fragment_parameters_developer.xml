<!-- res/layout/fragment_parameters_developer.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:padding="@dimen/screen_padding_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 1. ОТЛАДКА WEBVIEW ===== -->
        <TextView
            style="@style/Text.Title.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_s"
            android:text="@string/dev_section_webview" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_s">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/dev_webview_debug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/height_button"
                android:padding="@dimen/spacing_s"
                style="@style/Text.Body"
                android:text="@string/dev_webview_debug" />

            <Button
                android:id="@+id/dev_clear_cache"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@string/dev_webview_clear_cache" />

        </LinearLayout>

        <!-- ===== 2. ИНФОРМАЦИЯ ОБ ОБОЛОЧКЕ ===== -->
        <TextView
            style="@style/Text.Title.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/dev_section_shell" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_s">

            <Button
                android:id="@+id/dev_shell_manifest"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@string/dev_shell_manifest" />

            <Button
                android:id="@+id/dev_shell_reload"
                style="@style/Button.Warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@string/dev_shell_reload" />

        </LinearLayout>

        <!-- ===== 3. СИСТЕМНАЯ ИНФОРМАЦИЯ ===== -->
        <TextView
            style="@style/Text.Title.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/dev_section_system" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_s">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_s">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_device_model" />

                <TextView
                    android:id="@+id/dev_device_model_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/unknown" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_s">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_android_version" />

                <TextView
                    android:id="@+id/dev_android_version_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/unknown" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_s">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_sdk_level" />

                <TextView
                    android:id="@+id/dev_sdk_level_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/unknown" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="?attr/textDimColor"
                android:layout_marginVertical="@dimen/spacing_s" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_s">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_app_version" />

                <TextView
                    android:id="@+id/dev_app_version_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/unknown" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_s">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_app_code" />

                <TextView
                    android:id="@+id/dev_app_code_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/unknown" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_s"
                android:paddingBottom="@dimen/spacing_s">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_app_channel" />

                <TextView
                    android:id="@+id/dev_app_channel_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/unknown" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== 4. УПРАВЛЕНИЕ ДАННЫМИ ===== -->
        <TextView
            style="@style/Text.Title.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/dev_section_data" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_s">

            <LinearLayout
                android:id="@+id/dev_cache_size_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_cache_size" />

                <TextView
                    android:id="@+id/dev_cache_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/dev_cache_size_value"
                    android:textAlignment="viewEnd" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="?attr/textDimColor"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s" />

            <LinearLayout
                android:id="@+id/dev_shells_size_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_shells_size" />

                <TextView
                    android:id="@+id/dev_shells_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/dev_shells_size_value"
                    android:textAlignment="viewEnd" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="?attr/textDimColor"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s" />

            <LinearLayout
                android:id="@+id/dev_logs_size_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_logs_size" />

                <TextView
                    android:id="@+id/dev_logs_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/dev_logs_size_value"
                    android:textAlignment="viewEnd" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="?attr/textDimColor"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s" />

            <Button
                android:id="@+id/dev_clear_apps_cache"
                style="@style/Button.ClearCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/dev_clear_apps_cache" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="?attr/textDimColor"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_marginTop="@dimen/spacing_s" />

            <Button
                android:id="@+id/dev_clear_data"
                style="@style/Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@string/dev_clear_data" />

        </LinearLayout>

        <!-- ===== 5. УПРАВЛЕНИЕ ЛОГАМИ ===== -->
        <TextView
            style="@style/Text.Title.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/dev_section_logs" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_s">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/dev_logs_persist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/height_button"
                android:padding="@dimen/spacing_s"
                style="@style/Text.Body"
                android:text="@string/dev_logs_persist"
                android:checked="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="?attr/textDimColor"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_marginVertical="@dimen/spacing_s" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_logs_max_files" />

                <Spinner
                    android:id="@+id/dev_logs_max_files"
                    style="@style/Spinner" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="?attr/textDimColor"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_marginVertical="@dimen/spacing_s" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/dev_logs_max_size" />

                <Spinner
                    android:id="@+id/dev_logs_max_size"
                    style="@style/Spinner" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs"
                android:background="?attr/textDimColor"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_marginVertical="@dimen/spacing_s" />

            <Button
                android:id="@+id/dev_logs_show"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:text="@string/dev_logs_show" />

            <Button
                android:id="@+id/dev_logs_clear"
                style="@style/Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/dev_logs_clear" />

            <Button
                android:id="@+id/dev_logs_reset"
                style="@style/Button.Warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:layout_marginBottom="@dimen/spacing_xxs"
                android:text="@string/dev_logs_reset" />

        </LinearLayout>

        <!-- ===== 6. ИНСТРУМЕНТЫ ===== -->
        <TextView
            style="@style/Text.Title.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/dev_section_tools" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_s">

            <Button
                android:id="@+id/dev_restart_app"
                style="@style/Button.Warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/spacing_s"
                android:text="@string/dev_restart_app" />

        </LinearLayout>

        <!-- ===== ОТСТУП СНИЗУ ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxl" />

    </LinearLayout>

</ScrollView>