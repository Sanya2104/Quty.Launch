<!-- res/layout/fragment_store_item_detail.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/fragment_top"
        android:orientation="vertical">

        <!-- Превью -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/shell_preview_height"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_l"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/item_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image"
                android:contentDescription="@string/settings_personalization_shell_preview_description" />

        </androidx.cardview.widget.CardView>

        <!-- Название + автор + бейдж «Активна» (если активна) + меню -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_s"
            android:paddingTop="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="@dimen/spacing_m">

                <TextView
                    android:id="@+id/item_name"
                    style="@style/Text.Title.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/textPrimaryColor"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="QutyAuto" />

                <TextView
                    android:id="@+id/item_author"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:textColor="?attr/textDimColor"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="QutyTeam" />

            </LinearLayout>

            <!-- Бейдж «Активна» (стилизован под статус в каталоге).
                 Виден ТОЛЬКО когда ресурс активен (isActiveSameVersion). -->

            <!-- Кнопка-меню (ic_menu_dots). Видна, если в меню есть хотя бы один пункт. -->
            <TextView
                android:id="@+id/item_action_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_active"
                android:clickable="false"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:paddingStart="@dimen/spacing_s"
                android:paddingTop="@dimen/spacing_xxs"
                android:paddingEnd="@dimen/spacing_s"
                android:paddingBottom="@dimen/spacing_xxs"
                android:text="@string/store_applied"
                android:textColor="@color/status_granted"
                android:textSize="@dimen/text_l"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/item_menu_button"
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:layout_marginStart="@dimen/spacing_s"
                android:src="@drawable/ic_menu_dots"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/store_menu_more"
                android:padding="@dimen/spacing_m"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Прогресс установки -->
        <LinearLayout
            android:id="@+id/install_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_marginBottom="@dimen/spacing_m"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/install_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/update_progress_height"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="?attr/buttonPrimaryColor"
                android:progressBackgroundTint="?attr/dividerColor"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/install_progress_text"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:textStyle="bold"
                android:textColor="?attr/textPrimaryColor"
                tools:text="45%" />

        </LinearLayout>

        <!-- Карточка с метаданными -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/spacing_xs">

            <!-- ВЕРСИЯ -->
            <View
                android:id="@+id/item_version_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/item_version_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_version"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_version" />

                <TextView
                    android:id="@+id/item_version_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="v0.0.5" />

            </LinearLayout>

            <!-- УСТАНОВЛЕННАЯ ВЕРСИЯ -->
            <View
                android:id="@+id/item_installed_version_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/item_installed_version_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_version_code"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_installed_version" />

                <TextView
                    android:id="@+id/item_status_newer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:background="@drawable/bg_status_newer"
                    android:paddingStart="@dimen/spacing_s"
                    android:paddingEnd="@dimen/spacing_s"
                    android:paddingTop="@dimen/spacing_xxs"
                    android:paddingBottom="@dimen/spacing_xxs"
                    android:text="@string/store_status_newer"
                    android:textColor="@color/scheme_teal_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/item_installed_version_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="v0.0.4" />

            </LinearLayout>

            <!-- РАЗМЕР -->
            <View
                android:id="@+id/item_size_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/item_size_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_weight"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_size" />

                <TextView
                    android:id="@+id/item_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="5.2 MB" />

            </LinearLayout>

            <!-- ДАТА ПУБЛИКАЦИИ -->
            <View
                android:id="@+id/item_date_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/item_date_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_date" />

                <TextView
                    android:id="@+id/item_date_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="20.10.2026" />

            </LinearLayout>

            <!-- ТИП -->
            <View
                android:id="@+id/item_type_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/item_type_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_type"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_type" />

                <TextView
                    android:id="@+id/item_type_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="Пользовательская" />

            </LinearLayout>

            <!-- МИН. ВЕРСИЯ -->
            <View
                android:id="@+id/item_min_version_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/item_min_version_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_min_version"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_min_version" />

                <TextView
                    android:id="@+id/item_min_version_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="0.0.150" />

            </LinearLayout>

            <!-- ОРИЕНТАЦИЯ -->
            <View
                android:id="@+id/item_orientation_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/item_orientation_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_orientation"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_orientation" />

                <TextView
                    android:id="@+id/item_orientation_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="Авто" />

            </LinearLayout>

            <!-- РЕПОЗИТОРИЙ -->
            <LinearLayout
                android:id="@+id/item_repo_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/spacing_l"
                    android:layout_marginEnd="@dimen/spacing_l"
                    android:background="?attr/dividerColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_l"
                    android:paddingEnd="@dimen/spacing_l"
                    android:paddingTop="@dimen/spacing_s"
                    android:paddingBottom="@dimen/spacing_s"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_repo"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_repo" />

                    <Button
                        android:id="@+id/item_repo_button"
                        style="@style/Button.Glass.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="@dimen/spacing_m"
                        android:paddingEnd="@dimen/spacing_m"
                        android:paddingTop="@dimen/spacing_s"
                        android:paddingBottom="@dimen/spacing_s"
                        android:text="@string/settings_personalization_shell_info_repo_open" />

                </LinearLayout>

            </LinearLayout>

            <!-- TELEGRAM -->
            <LinearLayout
                android:id="@+id/item_telegram_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/spacing_l"
                    android:layout_marginEnd="@dimen/spacing_l"
                    android:background="?attr/dividerColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_l"
                    android:paddingEnd="@dimen/spacing_l"
                    android:paddingTop="@dimen/spacing_s"
                    android:paddingBottom="@dimen/spacing_s"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_telegram"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_telegram" />

                    <Button
                        android:id="@+id/item_telegram_button"
                        style="@style/Button.Glass.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="@dimen/spacing_m"
                        android:paddingEnd="@dimen/spacing_m"
                        android:paddingTop="@dimen/spacing_s"
                        android:paddingBottom="@dimen/spacing_s"
                        android:text="@string/settings_personalization_shell_info_telegram_open" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Действия (share / delete) — оставлены для обратной совместимости с разметкой,
             по умолчанию скрыты: их функционал теперь в выпадающем меню (ic_menu_dots). -->
        <LinearLayout
            android:id="@+id/item_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_marginTop="@dimen/spacing_l"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:visibility="gone"
            tools:visibility="gone">

            <Button
                android:id="@+id/item_share_button"
                style="@style/Button.Glass.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_s"
                android:minWidth="0dp"
                android:text="@string/store_detail_share" />

            <Button
                android:id="@+id/item_delete_button"
                style="@style/Button.Glass.Danger"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_s"
                android:minWidth="0dp"
                android:text="@string/store_detail_delete" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxl" />

    </LinearLayout>

</ScrollView>