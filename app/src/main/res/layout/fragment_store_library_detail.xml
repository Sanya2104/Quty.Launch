<!-- res/layout/fragment_store_library_detail.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="@dimen/screen_padding_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/fragment_top"
        android:orientation="vertical">

        <!-- Превью (обёрнуто в CardView для скругления углов) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/shell_preview_height"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_l"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/shell_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image"
                android:contentDescription="@string/settings_personalization_shell_preview_description" />

        </androidx.cardview.widget.CardView>

        <!-- Название + автор + кнопка действия -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_s"
            android:paddingTop="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="@dimen/spacing_m">

                <TextView
                    android:id="@+id/shell_name"
                    style="@style/Text.Title.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/textPrimaryColor"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="QutyAuto" />

                <TextView
                    android:id="@+id/shell_author"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:textColor="?attr/textDimColor"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="QutyTeam" />

            </LinearLayout>

            <!-- Кнопка действия (Применить / Активна) -->
            <Button
                android:id="@+id/btn_apply"
                style="@style/Button.Glass.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_button"
                android:minWidth="120dp"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:text="@string/store_apply" />

        </LinearLayout>

        <!-- Блок информации -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/spacing_xs">

            <!-- Версия -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_version"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_version" />

                <TextView
                    android:id="@+id/shell_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="v0.0.24" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor" />

            <!-- Тип -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_type"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_type" />

                <TextView
                    android:id="@+id/shell_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="Пользовательская" />

            </LinearLayout>

            <!-- Размер (только для кастомных) -->
            <View
                android:id="@+id/shell_size_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/shell_size_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_weight"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_size" />

                <TextView
                    android:id="@+id/shell_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="5.2 MB" />

            </LinearLayout>

            <!-- Путь к файлу (только для кастомных) -->
            <View
                android:id="@+id/shell_path_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/shell_path_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_folder"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/store_library_detail_path" />

                <TextView
                    android:id="@+id/shell_path"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    style="@style/Text.Small"
                    android:maxLines="2"
                    android:ellipsize="middle"
                    android:textAlignment="viewEnd"
                    tools:text="/data/.../QutyAuto.qutyshell" />

            </LinearLayout>

            <!-- Ориентация -->
            <View
                android:id="@+id/shell_orientation_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/shell_orientation_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_orientation"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_orientation" />

                <TextView
                    android:id="@+id/shell_orientation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="Авто" />

            </LinearLayout>

            <!-- Мин. версия Quty.Launch -->
            <View
                android:id="@+id/shell_min_version_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:layout_marginEnd="@dimen/spacing_l"
                android:background="?attr/dividerColor"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/shell_min_version_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_min_version"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Body.Dim"
                    android:text="@string/settings_personalization_shell_info_min_version" />

                <TextView
                    android:id="@+id/shell_min_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd"
                    tools:text="0.0.150" />

            </LinearLayout>

            <!-- Репозиторий -->
            <LinearLayout
                android:id="@+id/shell_repo_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/spacing_l"
                    android:layout_marginEnd="@dimen/spacing_l"
                    android:background="?attr/dividerColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_l"
                    android:paddingEnd="@dimen/spacing_l"
                    android:paddingTop="@dimen/spacing_s"
                    android:paddingBottom="@dimen/spacing_s"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_repo"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_repo" />

                    <Button
                        android:id="@+id/shell_repo_button"
                        style="@style/Button.Glass.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="@dimen/spacing_m"
                        android:paddingEnd="@dimen/spacing_m"
                        android:paddingTop="@dimen/spacing_s"
                        android:paddingBottom="@dimen/spacing_s"
                        android:text="@string/settings_personalization_shell_info_repo_open" />

                </LinearLayout>

            </LinearLayout>

            <!-- Telegram -->
            <LinearLayout
                android:id="@+id/shell_telegram_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/spacing_l"
                    android:layout_marginEnd="@dimen/spacing_l"
                    android:background="?attr/dividerColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_l"
                    android:paddingEnd="@dimen/spacing_l"
                    android:paddingTop="@dimen/spacing_s"
                    android:paddingBottom="@dimen/spacing_s"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_telegram"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_telegram" />

                    <Button
                        android:id="@+id/shell_telegram_button"
                        style="@style/Button.Glass.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="@dimen/spacing_m"
                        android:paddingEnd="@dimen/spacing_m"
                        android:paddingTop="@dimen/spacing_s"
                        android:paddingBottom="@dimen/spacing_s"
                        android:text="@string/settings_personalization_shell_info_telegram_open" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Кнопки «Поделиться» / «Удалить» (только для кастомных) -->
        <LinearLayout
            android:id="@+id/shell_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:visibility="gone"
            tools:visibility="visible">

            <Button
                android:id="@+id/btn_share"
                style="@style/Button.Glass.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_s"
                android:minWidth="0dp"
                android:text="@string/store_library_detail_share" />

            <Button
                android:id="@+id/btn_delete"
                style="@style/Button.Glass.Danger"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_s"
                android:minWidth="0dp"
                android:text="@string/store_library_detail_delete" />

        </LinearLayout>

        <!-- Отступ снизу -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxl" />

    </LinearLayout>

</ScrollView>