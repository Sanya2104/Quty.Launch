<!-- res/layout/dialog_shell_info.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/spacing_l"
    android:paddingEnd="@dimen/spacing_l"
    android:paddingTop="@dimen/spacing_xl"
    android:paddingBottom="@dimen/spacing_xl">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/radius_large"
        app:cardElevation="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="600dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_l"
                android:paddingEnd="@dimen/spacing_l"
                android:paddingTop="@dimen/spacing_l"
                android:paddingBottom="@dimen/spacing_l">

                <!-- ============================================================ -->
                <!-- ===== ЗАГОЛОВОК ============================================ -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_m">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Title.Medium"
                        android:text="@string/settings_personalization_shell_info_title" />

                    <ImageButton
                        android:id="@+id/shell_info_close_button"
                        android:layout_width="@dimen/icon_large"
                        android:layout_height="@dimen/icon_large"
                        android:src="@drawable/ic_close"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close"
                        android:padding="@dimen/spacing_s" />

                </LinearLayout>

                <!-- ============================================================ -->
                <!-- ===== НАЗВАНИЕ ============================================= -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_title"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_name" />

                    <TextView
                        android:id="@+id/shell_info_name_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAlignment="viewEnd" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerColor" />

                <!-- ============================================================ -->
                <!-- ===== ВЕРСИЯ =============================================== -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_version"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_version" />

                    <TextView
                        android:id="@+id/shell_info_version_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAlignment="viewEnd" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerColor" />

                <!-- ============================================================ -->
                <!-- ===== АВТОР ================================================ -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_author"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_author" />

                    <TextView
                        android:id="@+id/shell_info_author_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAlignment="viewEnd" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerColor" />

                <!-- ============================================================ -->
                <!-- ===== ТИП ================================================== -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_type"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_type" />

                    <TextView
                        android:id="@+id/shell_info_type_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAlignment="viewEnd" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerColor" />

                <!-- ============================================================ -->
                <!-- ===== ТРЕБУЕТСЯ QUTY.LAUNCH ================================ -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_min_version"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_min_version" />

                    <TextView
                        android:id="@+id/shell_info_min_version_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAlignment="viewEnd" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerColor" />

                <!-- ============================================================ -->
                <!-- ===== ОРИЕНТАЦИЯ =========================================== -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:src="@drawable/ic_orientation"
                        android:contentDescription="@string/empty"
                        android:layout_marginEnd="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Text.Body.Dim"
                        android:text="@string/settings_personalization_shell_info_orientation" />

                    <TextView
                        android:id="@+id/shell_info_orientation_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAlignment="viewEnd" />

                </LinearLayout>

                <!-- ============================================================ -->
                <!-- ===== РЕПОЗИТОРИЙ (если есть) ============================== -->
                <!-- ============================================================ -->

                <LinearLayout
                    android:id="@+id/shell_info_repo_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/dividerColor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="@dimen/spacing_s"
                        android:paddingBottom="@dimen/spacing_s">

                        <ImageView
                            android:layout_width="@dimen/icon_small"
                            android:layout_height="@dimen/icon_small"
                            android:src="@drawable/ic_repo"
                            android:contentDescription="@string/empty"
                            android:layout_marginEnd="@dimen/spacing_m" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/Text.Body.Dim"
                            android:text="@string/settings_personalization_shell_info_repo" />

                        <Button
                            android:id="@+id/shell_info_repo_button"
                            style="@style/Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="@dimen/spacing_m"
                            android:paddingEnd="@dimen/spacing_m"
                            android:paddingTop="@dimen/spacing_s"
                            android:paddingBottom="@dimen/spacing_s"
                            android:text="@string/settings_personalization_shell_info_repo_open" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

</FrameLayout>