<!-- res/layout/fragment_logger.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:paddingTop="@dimen/fragment_top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <!-- ============================================================ -->
        <!-- ===== ПАНЕЛЬ ДЕЙСТВИЙ ====================================== -->
        <!-- ============================================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/spacing_s"
            android:paddingBottom="@dimen/spacing_s"
            android:paddingStart="@dimen/spacing_l"
            android:paddingEnd="@dimen/spacing_m">

            <!-- Счётчик записей -->
            <TextView
                android:id="@+id/logger_counter"
                style="@style/Text.Body.Dim"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                tools:text="0 / 500" />

            <!-- Скролл вниз -->
            <ImageButton
                android:id="@+id/logger_action_scroll_bottom"
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:src="@drawable/ic_arrow_down"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/logger_action_scroll_bottom"
                android:padding="@dimen/spacing_m"
                app:tint="?attr/buttonPrimaryColor" />

            <!-- Очистить -->
            <ImageButton
                android:id="@+id/logger_action_clear"
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:src="@drawable/ic_trash"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/logger_action_clear"
                android:padding="@dimen/spacing_m"
                app:tint="?attr/textDimColor" />

            <!-- Копировать всё -->
            <ImageButton
                android:id="@+id/logger_action_copy"
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:src="@drawable/ic_copy"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/logger_action_copy"
                android:padding="@dimen/spacing_m"
                app:tint="?attr/textDimColor" />

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ===== КАРТОЧКА С ЛОГАМИ ==================================== -->
        <!-- ============================================================ -->

        <FrameLayout
            android:id="@+id/logger_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_marginBottom="@dimen/spacing_l"
            android:background="@drawable/bg_card_rounded"
            tools:ignore="NestedWeights, UselessParent">

            <!-- Список логов -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/logger_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:paddingTop="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_m"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

            <!-- Пустое состояние -->
            <TextView
                android:id="@+id/logger_empty"
                style="@style/Text.Body.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.5"
                android:gravity="center"
                android:text="@string/logger_empty"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>