<!-- res/layout/fragment_settings_shell.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/fragment_top"
        android:orientation="vertical">

        <!-- ============================================================ -->
        <!-- ===== SAFE MODE БАННЕР ===================================== -->
        <!-- ============================================================ -->

        <LinearLayout
            android:id="@+id/safe_mode_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_marginTop="@dimen/spacing_l"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_update_error"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m"
                    app:tint="@color/status_warning" />

                <TextView
                    style="@style/Text.Title.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/safe_mode_banner_title"
                    android:textColor="@color/status_warning" />

            </LinearLayout>

            <TextView
                style="@style/Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/safe_mode_banner_message" />

            <Button
                android:id="@+id/safe_mode_exit_button"
                style="@style/Button.Glass.Danger"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="@dimen/spacing_m"
                android:minWidth="0dp"
                android:text="@string/safe_mode_exit_button" />

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ===== АКТИВНАЯ ОБОЛОЧКА ==================================== -->
        <!-- ============================================================ -->

        <TextView
            style="@style/Text.Title.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:text="@string/settings_personalization_active_shell" />

        <TextView
            android:id="@+id/shell_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:padding="@dimen/spacing_l"
            style="@style/Text.Body.Secondary"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/settings_personalization_no_shell" />

        <androidx.cardview.widget.CardView
            android:id="@+id/shell_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/shell_preview"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/shell_preview_height"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_image"
                    android:contentDescription="@string/store_preview_description" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_l"
                    android:paddingEnd="@dimen/spacing_s"
                    android:paddingTop="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_m">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/shell_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Title.Small"
                            android:textColor="?attr/textPrimaryColor"
                            tools:text="@string/settings_personalization_shell_info_name"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/shell_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            style="@style/Text.Body"
                            android:textColor="?attr/textSecondaryColor"
                            tools:text="@string/settings_personalization_shell_info_version"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/shell_menu_button"
                        android:layout_width="@dimen/icon_large"
                        android:layout_height="@dimen/icon_large"
                        android:src="@drawable/ic_menu_dots"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/settings_personalization_shell_info_title"
                        android:padding="@dimen/spacing_m" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/store_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_marginTop="@dimen/spacing_m"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_rounded_ripple"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/spacing_l"
            android:paddingEnd="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_l">

            <ImageView
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:src="@drawable/ic_store"
                android:contentDescription="@string/empty"
                android:layout_marginEnd="@dimen/spacing_m" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Text.Body"
                android:text="@string/settings_personalization_open_store" />

            <ImageView
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:src="@drawable/ic_arrow_forward"
                android:contentDescription="@string/empty" />

        </LinearLayout>

        <TextView
            style="@style/Text.Title.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/settings_personalization_color_scheme_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/color_scheme_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_s"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:clipToPadding="false" />

        <TextView
            style="@style/Text.Title.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/settings_personalization_animations_title" />

        <TextView
            android:id="@+id/animations_system_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:background="@drawable/bg_orientation_lock_hint"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_marginBottom="@dimen/spacing_s"
            style="@style/Text.Body"
            android:text="@string/settings_personalization_animations_system_disabled"
            android:textColor="@color/status_warning" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_rounded"
            android:paddingStart="@dimen/spacing_l"
            android:paddingEnd="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_l">

            <ImageView
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:src="@drawable/ic_theme_light"
                android:contentDescription="@string/empty"
                android:layout_marginEnd="@dimen/spacing_m" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/animations_switch"
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="0dp"
                android:text="@string/settings_personalization_animations"
                tools:ignore="VisualLintButtonSize" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxl" />

    </LinearLayout>

</ScrollView>