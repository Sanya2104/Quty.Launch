<!-- res/layout/fragment_settings_general.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/fragment_top"
        android:orientation="vertical">

        <!-- ============================================================ -->
        <!-- ===== ТЕМА ОФОРМЛЕНИЯ ===================================== -->
        <!-- ============================================================ -->

        <TextView
            style="@style/Text.Title.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:text="@string/settings_theme_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="@dimen/spacing_s">

            <!-- Светлая тема -->
            <LinearLayout
                android:id="@+id/theme_light_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_s"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:minHeight="130dp">

                <ImageView
                    android:layout_width="@dimen/icon_large"
                    android:layout_height="@dimen/icon_large"
                    android:src="@drawable/ic_theme_light"
                    android:contentDescription="@string/settings_theme_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="@string/settings_theme_light"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_s"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_light_desc"
                    android:textColor="?attr/textHintColor"
                    android:textSize="@dimen/text_xs"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Тёмная тема -->
            <LinearLayout
                android:id="@+id/theme_dark_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:minHeight="130dp">

                <ImageView
                    android:layout_width="@dimen/icon_large"
                    android:layout_height="@dimen/icon_large"
                    android:src="@drawable/ic_theme_dark"
                    android:contentDescription="@string/settings_theme_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="@string/settings_theme_dark"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_s"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_dark_desc"
                    android:textColor="?attr/textHintColor"
                    android:textSize="@dimen/text_xs"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Системная тема -->
            <LinearLayout
                android:id="@+id/theme_system_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_s"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:minHeight="130dp">

                <ImageView
                    android:layout_width="@dimen/icon_large"
                    android:layout_height="@dimen/icon_large"
                    android:src="@drawable/ic_theme_system"
                    android:contentDescription="@string/settings_theme_system" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="@string/settings_theme_system"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_s"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_system_desc"
                    android:textColor="?attr/textHintColor"
                    android:textSize="@dimen/text_xs"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ===== ОРИЕНТАЦИЯ ЭКРАНА =================================== -->
        <!-- ============================================================ -->

        <TextView
            style="@style/Text.Title.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/parameters_orientation_title" />

        <!-- Подсказка о блокировке ориентации с закруглением -->
        <TextView
            android:id="@+id/orientation_lock_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:background="@drawable/bg_orientation_lock_hint"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_marginBottom="@dimen/spacing_s"
            style="@style/Text.Body"
            android:text="@string/orientation_lock_hint_default"
            android:textColor="@color/status_warning" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="@dimen/spacing_s">

            <!-- Авто -->
            <LinearLayout
                android:id="@+id/orientation_auto_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_s"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:minHeight="70dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/orientation_auto"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_s"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/orientation_auto_desc"
                    android:textColor="?attr/textHintColor"
                    android:textSize="@dimen/text_xs"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Портретная -->
            <LinearLayout
                android:id="@+id/orientation_portrait_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:minHeight="70dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/orientation_portrait"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_s"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/orientation_portrait_desc"
                    android:textColor="?attr/textHintColor"
                    android:textSize="@dimen/text_xs"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Ландшафтная -->
            <LinearLayout
                android:id="@+id/orientation_landscape_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_s"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:minHeight="70dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/orientation_landscape"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_s"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/orientation_landscape_desc"
                    android:textColor="?attr/textHintColor"
                    android:textSize="@dimen/text_xs"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>


        <!-- ============================================================ -->
        <!-- ===== ЯЗЫК ================================================= -->
        <!-- ============================================================ -->

        <TextView
            style="@style/Text.Title.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/settings_language_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="@dimen/spacing_s">

            <!-- Русский -->
            <LinearLayout
                android:id="@+id/language_russian_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_s"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:minHeight="70dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_russian"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_s"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_russian_desc"
                    android:textColor="?attr/textHintColor"
                    android:textSize="@dimen/text_xs"
                    android:gravity="center" />

            </LinearLayout>

            <!-- English -->
            <LinearLayout
                android:id="@+id/language_english_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_s"
                android:background="@drawable/bg_theme_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:minHeight="70dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_english"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_s"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_english_desc"
                    android:textColor="?attr/textHintColor"
                    android:textSize="@dimen/text_xs"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ===== ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ============================ -->
        <!-- ============================================================ -->

        <TextView
            style="@style/Text.Title.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_xl"
            android:text="@string/parameters_additional_title" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded_ripple"
            android:padding="@dimen/spacing_l">

            <!-- Полноэкранный режим -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_fullscreen"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/fullscreen_switch"
                    style="@style/Text.Body.Dim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:text="@string/additional_fullscreen"
                    tools:ignore="VisualLintButtonSize" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/dividerColor" />

            <!-- Строгий режим -->
            <LinearLayout
                android:id="@+id/check_update_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:src="@drawable/ic_strict_mode"
                    android:contentDescription="@string/empty"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/strict_mode_switch"
                    style="@style/Text.Body.Dim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:text="@string/additional_strict_mode"
                    tools:ignore="VisualLintButtonSize" />

            </LinearLayout>

        </LinearLayout>

        <!-- Отступ снизу -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxl" />

    </LinearLayout>

</ScrollView>