<?xml version="1.0" encoding="UTF-8"?>
<!--
    Конфигурация lint для проекта Quty.Launch.

    Здесь подавляются проверки, которые мы осознанно игнорируем.
    Для каждой записи — пояснение, почему она здесь.
-->
<lint>

    <!-- ============================================================ -->
    <!-- OVERDRAW                                                      -->
    <!-- ============================================================ -->

    <!--
        Overdraw: root-элемент layout'а рисует фон (?android:attr/colorBackground
        или ?attr/colorSurface), который уже рисует тема.

        На практике — микропроизводительность, которая не заметна на современных
        устройствах. Убирать фон у root-элемента рискованно: при cold start
        возможны артефакты (чёрный/белый фон до первой отрисовки WebView/фрагмента).
        Осознанное решение — оставить как есть.
    -->
    <issue id="Overdraw" severity="ignore" />

    <!-- ============================================================ -->
    <!-- SETTEXTI18N                                                   -->
    <!-- ============================================================ -->

    <!--
        SetTextI18n: Number.toString() для versionCode, SDK_INT и других
        целых чисел без разделителей.

        Локаль тут не важна: versionCode = "655" в любой локали, SDK_INT = "34"
        тоже. Ложное срабатывание. String.format("%d", value) даст тот же
        результат, но код станет менее читаемым.
    -->
    <issue id="SetTextI18n" severity="ignore" />

    <!-- ============================================================ -->
    <!-- APPBUNDLELOCALECHANGES                                       -->
    <!-- ============================================================ -->

    <!--
        AppBundleLocaleChanges: lint предупреждает, что динамическая смена
        локали (attachBaseContext + setLocale) может не работать с App Bundle
        из-за разбиения по языкам, если не используется Play Core library.

        Мы не публикуем AAB — только APK через GitHub Releases. Разбиения
        по языкам нет. Ограничение не применимо.
    -->
    <issue id="AppBundleLocaleChanges" severity="ignore" />

</lint>